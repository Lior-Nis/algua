[Unit]
Description=Algua autonomous research cycle — daily

[Timer]
# DAILY, 06:00 UTC — clear of the paper window (21:30 UTC) and market hours. Research and paper do NOT
# share a lock and do not need to: research exploration writes only its per-run scratch funnel (never
# the authoritative DB), so it cannot contend with the paper operator; the sole authoritative funnel
# writer, `paper merge-back`, has its own merge_back.lock + operator policy. Research is NOT
# session-gated — it runs on historical snapshots any day — so the time is non-critical.
#
# WHY DAILY IS SAFE FOR THE FUNNEL. Because exploration runs on a THROWAWAY scratch copy, a cycle's
# `research promote` is a PREVIEW that records NO breadth and burns NO holdout on the authoritative
# funnel — so it never consumes the FDR budget (<=16 promotion-eligible binding tests / 365 days).
# That budget is spent only by a human-run `paper merge-back`. Daily exploration is therefore free of
# funnel cost; its only real costs are compute/API per cycle (tune N_HYPOTHESES/TIMEOUT in the env
# file) and disk — each cycle leaves a worktree, which the driver AUTO-PRUNES after
# RESEARCH_WORKTREE_RETENTION_DAYS (default 7; the authored code persists on its branch regardless).
OnCalendar=*-*-* 06:00:00 UTC
# Cover a fire missed while the box was off; research has no session gate, so it just runs once late.
Persistent=true

[Install]
WantedBy=timers.target
