[Unit]
Description=Algua paper-operator timer — every 20 minutes, session-gated

[Timer]
# The exact firing times are NON-CRITICAL: the XNYS calendar gate inside `algua operator run` no-ops
# weekend/holiday firings, and the per-session marker makes a firing idempotent — so an early/late/
# DST-shifted fire is safe. DAILY on purpose, NOT Mon..Fri: the calendar gate — not the timer spec —
# owns session logic; a weekdays-only spec would double-encode the exchange calendar and silently
# drift on holidays.
#
# REPEATING, and OFF the merge-back drainer's grid. This used to be a single daily fire at
# `21:30:00 UTC` — which is exactly on `algua-mergeback-drain.timer`'s `*:00/30:00` grid. Both jobs
# take the SAME `operator.lock`, and a drain cycle holds it for many minutes (a full quality gate
# plus an authoritative evidence sweep), so the paper fire lost the race and emitted
# `{"ran": false, "reason": "locked"}`. With only one fire a day there was no retry: `session_gate`
# always targets the most-recent COMPLETED session, so the missed one is never revisited — it just
# shows up later as `skipped_sessions`. One lock race = one trading session silently lost (observed
# 2026-08-17: the 08-14 session never traded).
#
# Firing every 20 minutes at :07/:27/:47 fixes both halves. The offset keeps every fire off the
# drainer's :00/:30 starts, and the repetition means a fire that still loses the race simply retries
# 20 minutes later instead of waiting a day. The extra fires are nearly free: the session gate
# no-ops them (`already_ran`) for the cost of a calendar load and a marker read, and it also
# self-heals the OTHER ways a cycle declines to complete — a `deferred: true` reconcile cycle
# deliberately leaves the marker unwritten so "the next fire retries", which only works if there IS
# a next fire before the session rolls over.
OnCalendar=*-*-* *:07/20:00 UTC
# Catch up a fire missed while the box was off (the calendar gate still decides if it acts).
Persistent=true

[Install]
WantedBy=timers.target
