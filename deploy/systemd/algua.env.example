# Algua operator environment — copy to /etc/algua/algua.env and fill in.
# Loaded by the systemd units via EnvironmentFile=. Keep this file mode 0600 (it holds secrets).

# --- Storage --------------------------------------------------------------------------------------
# Registry/ledger SQLite DB. The per-session idempotency marker (operator_sessions.json) lives
# BESIDE it, in this file's parent directory. The run lock (operator.lock) lives at the repo's
# per-worktree git dir, not here.
ALGUA_DB_PATH=/opt/algua/data/algua.db

# Bar snapshot the paper daily-session engine runs against. Expanded into the paper unit's
# ExecStart (`… paper run-all --snapshot ${ALGUA_PAPER_SNAPSHOT}`); it is the lone variable token of
# the `paper` job's canonical argv, so it must be set for the unit to bind.
ALGUA_PAPER_SNAPSHOT=

# --- Alert hook -----------------------------------------------------------------------------------
# Optional command fed the alert JSON on stdin when a run fails / halts / hits a corrupt marker /
# a wedged lock / a calendar-out-of-bounds anomaly. It is split with shlex and run with shell=False
# under a 10s timeout — NO shell interpolation of the payload (quote args as usual; no pipes/redirects
# — wrap those in a script). Empty = log-only (the structured operator_alert record is always
# emitted). Examples:
#   ALGUA_ALERT_CMD=/usr/bin/notify-send "algua operator alert"
#   ALGUA_ALERT_CMD=curl -sS -X POST -H 'content-type: application/json' -d @- https://hooks.example/algua
ALGUA_ALERT_CMD=

# --- Autonomous research loop (Codex-driven) ------------------------------------------------------
# Optional knobs for algua-research.{service,timer}. The driver (.codex/scripts/run-research-loop.sh)
# runs the agent SANDBOXED + EXPLORE-ISOLATED: codex `-s workspace-write` confines its writes to the
# worktree, and the driver builds a per-run SCRATCH funnel INSIDE that worktree — a scratch registry
# seeded from the real one (sqlite backup) plus a per-run COPY of the immutable snapshots — with
# ALGUA_DB_PATH / ALGUA_DATA_DIR / ALGUA_KNOWLEDGE_DIR / ALGUA_MLFLOW_TRACKING_URI all pointed at
# scratch. So the agent can neither read-through nor write the authoritative funnel. You normally set
# nothing here except ALGUA_DB_PATH above (the driver reads it as the AUTHORITATIVE registry to seed
# from). Requires `codex` on PATH and AUTHENTICATED for the unit's user. Exploration previews are free;
# the AUTHORITATIVE promote is a separate human-run `paper merge-back` (what the FDR throttle bounds).
#   N_HYPOTHESES  — strategy hypotheses to evaluate per cycle (default 3)
#   TIMEOUT       — hard wall-clock cap on the codex run (default 45m; keep < TimeoutStartSec - 5m)
#   THESIS        — optional ideation prompt (default: a broad PIT-correct cross-sectional edge)
#   RESEARCH_WORKTREE_RETENTION_DAYS — auto-prune research-run worktrees older than this (default 7;
#                   reclaims disposable venv+scratch only — authored code persists on its branch)
# N_HYPOTHESES=3
# TIMEOUT=45m
# RESEARCH_WORKTREE_RETENTION_DAYS=7

# --- Alpaca PAPER credentials ---------------------------------------------------------------------
# The operator trades PAPER only. Going live is a cryptographic, human-signed wall (see the go-live
# gate) — it is NOT unlocked by supplying live creds here, so only the paper account is configured.
# These names MUST carry the ALGUA_ prefix and match algua/config/settings.py field-for-field
# (env_prefix="ALGUA_"): alpaca_api_key / alpaca_api_secret / alpaca_paper_url. A bare
# ALPACA_API_KEY (no prefix) is IGNORED — the broker would come up unauthenticated and every
# scheduled run would fail closed.
ALGUA_ALPACA_API_KEY=
ALGUA_ALPACA_API_SECRET=
ALGUA_ALPACA_PAPER_URL=https://paper-api.alpaca.markets
