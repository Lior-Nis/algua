{
  "name": "algua-monitor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "VITE_ALGUA_DEMO=1 tsc -b && VITE_ALGUA_DEMO=1 vite build --outDir dist-demo",
    "verify:demo-build": "node scripts/verify-demo-build.mjs",
    "verify:viewport": "node scripts/verify-viewport.mjs",
    "check": "tsc --noEmit && vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "playwright": "^1.62.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10"
  }
}
