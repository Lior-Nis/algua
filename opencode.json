{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,

  "model": "openrouter/deepseek/deepseek-chat",
  "small_model": "openrouter/deepseek/deepseek-chat",

  "instructions": ["AGENTS.md"],

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "question": "deny",
    "doom_loop": "deny"
  },

  "tool_output": {
    "max_lines": 400,
    "max_bytes": 60000
  },

  "agent": {
    "research": { "model": "openrouter/deepseek/deepseek-chat" },
    "leap":     { "model": "openrouter/deepseek/deepseek-chat" },
    "forage":   { "model": "openrouter/deepseek/deepseek-chat" },
    "author":   { "model": "openrouter/deepseek/deepseek-chat" },
    "interpret":{ "model": "openrouter/deepseek/deepseek-chat" }
  }
}
